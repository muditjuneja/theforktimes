# Parsed by Workers static assets; this file is never served itself.
# Replaces the header rules that used to live in vercel.json.
#
# Rules are ADDITIVE, not overriding: every matching rule contributes, so a
# Cache-Control in the catch-all would be appended to the specific ones and
# produce "max-age=31536000, immutable, public, max-age=600". Caching is
# therefore set only on specific paths, and /* carries security headers alone.

# The plain-text exports from scripts/generate-latest.js. Both are deliberately
# extensionless, so Wrangler cannot infer a MIME type from the filename and
# would otherwise serve them as a download.
/md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300

/json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=300

# Astro fingerprints everything under /_astro/, so a changed file gets a
# changed URL and these can be cached indefinitely.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# HTML is left to the platform default (revalidate), which is what the
# homepage needs - it mirrors whichever edition is latest.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
