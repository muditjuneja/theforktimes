{
  "name": "theforktimes",
  "description": "A weekly newspaper for open source, ranked by what is actually moving.",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types ./scripts/generate-latest.js && astro build",
    "ingest": "node --experimental-strip-types ./scripts/ingest.js",
    "preview": "astro preview",
    "astro": "astro",
    "blurbs": "node --experimental-strip-types ./scripts/blurbs.js",
    "tweet": "node --experimental-strip-types ./scripts/tweet.js",
    "deploy": "D1_REMOTE=1 npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev",
    "issue": "node --experimental-strip-types ./scripts/issue.js",
    "backfill-d1": "node ./scripts/backfill-d1.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.0.7",
    "bulma": "^1.0.4",
    "chart.js": "^4.5.1",
    "sass": "^1.101.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0"
  }
}
